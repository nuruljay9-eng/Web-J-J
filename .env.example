# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode for the J&J Admin Inquiry Inbox (/admin-inquiries).
# Leave empty during first preview to claim a passcode via the first-run setup UI.
ADMIN_PASSCODE=

# SESSION_SECRET: Optional HMAC signing secret for admin bearer tokens.
SESSION_SECRET=

# WHATSAPP_NUMBER: International WhatsApp number without '+' (e.g., 6281234567890).
VITE_WHATSAPP_NUMBER="6281200000000"

# GOOGLE_SITE_VERIFICATION: Google Search Console verification meta content.
VITE_GSC_VERIFICATION=

# GA_MEASUREMENT_ID: Google Analytics 4 measurement ID (e.g., G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=
